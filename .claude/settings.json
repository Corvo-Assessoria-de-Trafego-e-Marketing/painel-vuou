{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/*.env)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(~/.corvo/credentials/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/credentials*.json)",
      "Read(**/client_secret*.json)",
      "Read(**/service-account*.json)",
      "Read(**/service_account*.json)"
    ],
    "ask": [
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.githooks/**)",
      "Edit(/.gitleaks.toml)",
      "Edit(/.mcp.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command",
              "& (Join-Path $env:CLAUDE_PROJECT_DIR '.claude/hooks/guarda-comandos.ps1'); exit $LASTEXITCODE"
            ],
            "timeout": 300,
            "statusMessage": "Harness de segurança da Corvo"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command",
              "& (Join-Path $env:CLAUDE_PROJECT_DIR '.claude/hooks/apos-edicao.ps1'); exit $LASTEXITCODE"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
